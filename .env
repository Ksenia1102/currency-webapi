APP_NAME=Currency API
VERSION=1.0.0
DEBUG=true

API_PREFIX=/api

DATABASE_URL=sqlite+aiosqlite:///./currency.db

CBR_API_URL=https://www.cbr-xml-daily.ru/daily_json.js
BACKGROUND_INTERVAL=30

WS_PATH=/ws

NATS_URL=nats://localhost:4222
NATS_UPDATES_CHANNEL=currency.updates
NATS_EVENTS_CHANNEL=currency.events
NATS_ENABLED=true

ENABLE_CRYPTO=true
ENABLE_TRADITIONAL=true

CRYPTO_API_URL=https://api.coingecko.com/api/v3/simple/price
CRYPTO_CURRENCIES=bitcoin,ethereum
CRYPTO_VS_CURRENCY=usd